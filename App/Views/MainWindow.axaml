<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:App"
        xmlns:vm="using:App.ViewModels"
        xmlns:views="using:App.Views"
        x:Class="App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        XYFocus.NavigationModes="Keyboard"
        Width="540"
        MinWidth="540"
        Height="675"
        MinHeight="675"
        Icon="/Assets/rna.ico"
        Title="Barcode Generator">

    <TabControl>
        <TabItem Header="Barcode Generator">
            <views:BarcodeGeneratorView DataContext="{Binding BarcodeGeneratorViewModel}"/>
        </TabItem>

        <TabItem Header="Sequence Splitting">
            <views:SequenceSplittingView DataContext="{Binding SequenceSplittingViewModel}"/>
        </TabItem>
    </TabControl>

</Window>